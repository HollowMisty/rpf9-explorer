<Window x:Class="RpfPreview.App.CharacterBrowserWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:RpfPreview.App"
 Title="Characters" Width="1200" Height="850" MinWidth="1000" MinHeight="700"
 Background="{DynamicResource AppBackground}" Foreground="{DynamicResource AppText}"
 FontFamily="Segoe UI" FontSize="12" WindowStartupLocation="CenterOwner" Loaded="Window_Loaded">
 <Window.Resources>
  <Style x:Key="CharacterCardStyle" TargetType="ListBoxItem">
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="Padding" Value="5"/><Setter Property="Margin" Value="3"/>
   <Setter Property="Background" Value="{DynamicResource AppSurface}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource AppBorder}"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
    <Border x:Name="Card" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsSelected" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AppAccent}"/><Setter TargetName="Card" Property="BorderThickness" Value="2"/></Trigger>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="Background" Value="{DynamicResource AppRaisedSurface}"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Grid Margin="20">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,14">
   <TextBlock Text="Characters" FontSize="24" FontWeight="SemiBold"/>
   <TextBlock Text="Browse faces and choose an available outfit." Foreground="{DynamicResource AppMutedText}" Margin="0,5,0,0"/>
  </StackPanel>
  <Grid Grid.Row="1" Margin="0,0,0,12">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="270"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel>
    <TextBlock Text="Find character" Margin="0,0,0,5"/>
    <TextBox x:Name="CharacterSearch" MinHeight="30" TextChanged="Search_Changed" AutomationProperties.Name="Find character" ToolTip="Search names, native filenames, components or an outfit ID. Use several words to narrow the results."/>
   </StackPanel>
   <Button Grid.Column="1" Content="Clear" Click="ClearSearch_Click" VerticalAlignment="Bottom" Margin="6,0,16,0"/>
   <StackPanel Grid.Column="2"><TextBlock Text="Character catalogue" Margin="0,0,0,5"/><ComboBox x:Name="CatalogSelector" DisplayMemberPath="Label" MinHeight="30" SelectionChanged="Catalog_Changed" AutomationProperties.Name="Character catalogue"/></StackPanel>
   <Button x:Name="BrowseCatalogButton" Grid.Column="3" Content="Open file…" Click="BrowseCatalog_Click" VerticalAlignment="Bottom" Margin="6,0,0,0"/>
  </Grid>
  <Grid Grid.Row="2">
   <Grid.ColumnDefinitions><ColumnDefinition Width="3*" MinWidth="420"/><ColumnDefinition Width="18"/><ColumnDefinition Width="2*" MinWidth="330"/></Grid.ColumnDefinitions>
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,8">
     <CheckBox x:Name="IncludeIncomplete" DockPanel.Dock="Right" Content="Show other outfits" Checked="Filter_Changed" Unchecked="Filter_Changed" ToolTip="Include ungrouped outfits and outfits with missing indexed model parts."/>
     <TextBlock x:Name="ResultCount" Text="Loading characters…" Foreground="{DynamicResource AppMutedText}"/>
    </DockPanel>
    <ListBox x:Name="CharacterList" Grid.Row="1" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource CharacterCardStyle}" SelectionChanged="Character_Changed" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Characters">
     <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ListBox.ItemsPanel>
     <ListBox.ItemTemplate><DataTemplate>
      <StackPanel ToolTip="{Binding NativeName}">
       <Grid Height="96" Background="{DynamicResource AppThumbnail}" Margin="0,0,0,6">
        <TextBlock Text="{Binding PreviewText}" TextAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource AppMutedText}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6"/>
        <Image Source="{Binding Thumbnail}" Stretch="Uniform"/>
       </Grid>
       <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" Height="34"/>
       <TextBlock Text="{Binding Coverage}" Foreground="{DynamicResource AppMutedText}" TextTrimming="CharacterEllipsis"/>
      </StackPanel>
     </DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <DockPanel Grid.Row="2" Margin="0,10,0,0">
     <Button x:Name="PreviousPageButton" Content="Previous" Click="PreviousPage_Click" DockPanel.Dock="Left"/>
     <Button x:Name="NextPageButton" Content="Next" Click="NextPage_Click" DockPanel.Dock="Right"/>
     <TextBlock x:Name="PageText" Text="" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource AppMutedText}"/>
    </DockPanel>
   </Grid>
   <Grid Grid.Column="2">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="2*" MinHeight="200"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*" MinHeight="85"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock x:Name="CharacterName" Text="Choose a character" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,8" TextTrimming="CharacterEllipsis"/>
    <Grid Grid.Row="1" Background="{DynamicResource AppThumbnail}">
     <local:ModelViewport x:Name="FacePreview"/>
     <TextBlock x:Name="FacePlaceholder" Text="Select a face on the left." Foreground="{DynamicResource AppMutedText}" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" IsHitTestVisible="False"/>
    </Grid>
    <TextBlock x:Name="FaceNote" Grid.Row="2" Text="Face preview only. Open an outfit to inspect its available parts together." Foreground="{DynamicResource AppMutedText}" TextWrapping="Wrap" Margin="0,6,0,12"/>
    <DockPanel Grid.Row="3" Margin="0,0,0,6"><TextBlock Text="Outfit" FontWeight="SemiBold"/><TextBlock x:Name="OutfitCount" Foreground="{DynamicResource AppMutedText}" Margin="8,0,0,0"/></DockPanel>
    <ListBox x:Name="OutfitList" Grid.Row="4" SelectionChanged="Outfit_Changed" AutomationProperties.Name="Outfits" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
     <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="3,5"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Coverage}" Foreground="{DynamicResource AppMutedText}" Margin="0,3,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <Expander Grid.Row="5" Header="Animation and file details" Margin="0,10,0,0">
     <StackPanel Margin="0,6,0,0">
      <CheckBox x:Name="AttachFaceCheck" Content="Attach eyes to head (preview approximation)" ToolTip="Keeps detached facial parts with the head. Native facial deformation is not reproduced."/>
      <TextBlock x:Name="NativeDetails" Foreground="{DynamicResource AppMutedText}" TextWrapping="Wrap" Margin="0,8,0,0" MaxHeight="68"/>
     </StackPanel>
    </Expander>
   </Grid>
  </Grid>
  <Grid Grid.Row="3" Margin="0,16,0,0">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Margin="0,0,14,0"><TextBlock x:Name="BrowserStatus" Text="Reading loaded catalogues…" TextWrapping="Wrap"/><ProgressBar x:Name="BrowserProgress" Height="3" IsIndeterminate="True" Margin="0,8,0,0"/></StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
    <Button x:Name="OpenStaticButton" Content="Open static preview" Visibility="Collapsed" Click="OpenStatic_Click" Margin="0,0,8,0"/>
    <Button x:Name="OpenOutfitButton" Content="Open outfit" IsEnabled="False" Click="OpenOutfit_Click" Margin="0,0,8,0"/>
    <Button Content="Close" IsCancel="True" Click="Close_Click"/>
   </StackPanel>
  </Grid>
 </Grid>
</Window>
